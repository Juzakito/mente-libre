# ============================================
# Mente Libre / Free Mind — Environment Variables
# ============================================
# Copy this file to .env.local for development:
#   cp .env.example .env.local
#
# NEVER commit .env, .env.local, or .env.production to Git.
# All production secrets should be set in Vercel Dashboard → Settings → Environment Variables.
# ============================================

# -------------------------------------------
# SUPABASE (Required)
# -------------------------------------------
# Get these from: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# -------------------------------------------
# GEMINI AI (Required for Chat feature)
# -------------------------------------------
# Get your key from: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# -------------------------------------------
# ANALYTICS (Optional)
# -------------------------------------------
# SheetDB webhook URL for event tracking
# Get yours from: https://sheetdb.io
VITE_SHEETS_WEBHOOK_URL=https://sheetdb.io/api/v1/your-sheet-id

# -------------------------------------------
# FEATURE FLAGS (Optional)
# -------------------------------------------
# Enable/disable features without code changes
VITE_FEATURE_CHAT_AI=true
VITE_FEATURE_B2B_DASHBOARD=true
VITE_FEATURE_EXPERTS=true
VITE_FEATURE_GAMIFICATION=true

# -------------------------------------------
# APP CONFIG (Optional)
# -------------------------------------------
# App version for cache busting
VITE_APP_VERSION=1.0.0

# Environment identifier
VITE_APP_ENV=development
